# Environment variables, names only. Values live in .env.local (git-ignored)
# and in Vercel's project settings. Never commit a value.

# ── Already in use ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
ADMIN_EMAILS=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
MAILING_ADDRESS=

# ── Live classes (classes-design.md section 13.1) ──────────────────────
# The first six match .claude-scratch/classes-dev/keys.env word for word.
CLOUDFLARE_ACCOUNT_ID=
# Preview and Development on Vercel.
CLOUDFLARE_REALTIMEKIT_APP_ID_DEV=
# Production on Vercel.
CLOUDFLARE_REALTIMEKIT_APP_ID_PROD=
CLOUDFLARE_REALTIMEKIT_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Local testing only. Never add it to Vercel: deployments use the project's OIDC token.
AI_GATEWAY_API_KEY=
# "1" on Production on release day only. With class_settings.classes_visible,
# both must be on for classes to show anywhere.
CLASSES_VISIBLE=
# Dev servers only (ignored when NODE_ENV=production): "1" treats both switches
# as open and joins as unpaused; "1" lets a test schedule a class minutes ahead;
# a folder that catches every email instead of Resend.
CLASSES_DEV_SWITCHES=
CLASSES_DEV_ALLOW_SOON=
EMAIL_DEV_OUTBOX=
# Optional: defaults to learnfrc-class-holds (prod) or learnfrc-class-holds-dev.
R2_HOLDS_BUCKET=
# Optional: defaults to anthropic/claude-opus-5.5 (an AI Gateway model id).
CLASSES_REVIEW_MODEL=
# openssl rand -hex 32. Salts the IP hashes.
CLASSES_AUDIT_SALT=
# Where safety email goes (Dhiren's address in Production).
CLASSES_SAFETY_EMAIL=
# Account ids that never get an hours letter, comma-separated.
CLASSES_NO_LETTER_USER_IDS=
